{
  "version": 1,

  "notes": ["max_statement_bytes is 65536. A read against a several-hundred-column schema that names 300 columns with aliases is around 18 KB, so this leaves roughly a fourfold headroom over the largest legitimate analytical query anticipated for the motivating database, while keeping the work an unauthenticated-in-effect agent can demand of one goroutine bounded. Raise it in an overlay rather than in a rebuild if a real query is refused."],
  "max_statement_bytes": 65536,

  "read_statements": [
    {"id": "read-select", "match": "select", "reason": "SELECT is a read"},
    {"id": "read-with", "match": "with", "reason": "WITH introduces a common table expression whose body is checked like any other statement"},
    {"id": "read-values", "match": "values", "reason": "VALUES yields a constant row set"},
    {"id": "read-show", "match": "show", "engines": ["mysql"], "reason": "SHOW reports server and schema metadata"},
    {"id": "read-describe", "match": "describe", "engines": ["mysql"], "prefix": true, "reason": "DESCRIBE reports the columns of a table, or the plan of the statement that follows it"},
    {"id": "read-explain", "match": "explain", "prefix": true, "reason": "EXPLAIN reports the plan of the statement that follows it; EXPLAIN ANALYZE is refused separately because it executes that statement"}
  ],

  "forbidden_statements": [
    {"id": "stmt-insert", "match": "insert", "reason": "INSERT writes rows"},
    {"id": "stmt-update", "match": "update", "reason": "UPDATE writes rows"},
    {"id": "stmt-delete", "match": "delete", "reason": "DELETE removes rows, including inside a data-modifying CTE"},
    {"id": "stmt-merge", "match": "merge", "reason": "MERGE writes rows"},
    {"id": "stmt-replace", "match": "replace", "reason": "REPLACE writes rows in MySQL", "safe_as_function": "Every MySQL REPLACE statement form names a table before anything else: REPLACE tbl, REPLACE INTO tbl, REPLACE LOW_PRIORITY tbl, REPLACE DELAYED tbl, and REPLACE INTO `tbl`. All five were exercised against this ruleset and all five are refused by this rule. None of them can put REPLACE immediately before an open parenthesis, so REPLACE( is always the string function and never the statement."},

    {"id": "stmt-create", "match": "create", "reason": "CREATE changes the schema"},
    {"id": "stmt-alter", "match": "alter", "reason": "ALTER changes the schema"},
    {"id": "stmt-alter-system", "match": "alter system", "reason": "ALTER SYSTEM changes server configuration"},
    {"id": "stmt-drop", "match": "drop", "reason": "DROP removes schema objects"},
    {"id": "stmt-truncate", "match": "truncate", "reason": "TRUNCATE empties a table"},
    {"id": "stmt-rename", "match": "rename", "reason": "RENAME changes the schema"},

    {"id": "stmt-exec", "match": "exec", "reason": "EXEC runs a stored procedure or dynamic SQL the gate cannot inspect"},
    {"id": "stmt-execute", "match": "execute", "reason": "EXECUTE runs a stored procedure or dynamic SQL the gate cannot inspect"},
    {"id": "stmt-execute-as", "match": "execute as", "reason": "EXECUTE AS switches the security context"},
    {"id": "stmt-call", "match": "call", "reason": "CALL runs a stored procedure the gate cannot inspect"},
    {"id": "stmt-prepare", "match": "prepare", "reason": "PREPARE stages a statement the gate cannot inspect"},
    {"id": "stmt-deallocate", "match": "deallocate", "reason": "DEALLOCATE manipulates prepared statements"},
    {"id": "stmt-do", "match": "do", "reason": "DO runs an anonymous code block"},

    {"id": "stmt-begin", "match": "begin", "reason": "BEGIN opens a transaction or a code block"},
    {"id": "stmt-commit", "match": "commit", "reason": "COMMIT ends a transaction"},
    {"id": "stmt-rollback", "match": "rollback", "reason": "ROLLBACK ends a transaction"},
    {"id": "stmt-save", "match": "save", "reason": "SAVE creates a savepoint"},
    {"id": "stmt-start", "match": "start", "reason": "START begins a transaction or a replication process"},
    {"id": "stmt-set", "match": "set", "reason": "SET changes session state the gate's verdicts depend on"},
    {"id": "stmt-use", "match": "use", "reason": "USE switches the current database"},
    {"id": "stmt-revert", "match": "revert", "reason": "REVERT restores a previous security context"},

    {"id": "stmt-grant", "match": "grant", "reason": "GRANT changes permissions"},
    {"id": "stmt-revoke", "match": "revoke", "reason": "REVOKE changes permissions"},
    {"id": "stmt-deny", "match": "deny", "reason": "DENY changes permissions"},

    {"id": "stmt-flush", "match": "flush", "reason": "FLUSH changes server state"},
    {"id": "stmt-reset", "match": "reset", "reason": "RESET changes server or session state"},
    {"id": "stmt-install", "match": "install", "reason": "INSTALL loads a server plugin or component"},
    {"id": "stmt-uninstall", "match": "uninstall", "reason": "UNINSTALL removes a server plugin or component"},
    {"id": "stmt-lock", "match": "lock", "reason": "LOCK holds locks on the target database"},
    {"id": "stmt-unlock", "match": "unlock", "reason": "UNLOCK manipulates locks on the target database"},
    {"id": "stmt-dbcc", "match": "dbcc", "reason": "DBCC runs database console commands"},
    {"id": "stmt-reconfigure", "match": "reconfigure", "reason": "RECONFIGURE applies server configuration changes"},
    {"id": "stmt-bulk", "match": "bulk", "reason": "BULK INSERT loads a file into a table"},
    {"id": "stmt-waitfor", "match": "waitfor", "reason": "WAITFOR holds the connection open for an arbitrary time"},

    {"id": "stmt-into", "match": "into", "reason": "SELECT ... INTO creates a table in T-SQL and PostgreSQL and assigns variables elsewhere"},
    {"id": "stmt-into-outfile", "match": "into outfile", "reason": "SELECT ... INTO OUTFILE writes a file on the MySQL server"},
    {"id": "stmt-into-dumpfile", "match": "into dumpfile", "reason": "SELECT ... INTO DUMPFILE writes a file on the MySQL server"},
    {"id": "stmt-copy", "match": "copy", "reason": "COPY reads and writes server-side files and can run a program"},
    {"id": "stmt-from-program", "match": "from program", "reason": "COPY ... FROM PROGRAM executes a shell command on the PostgreSQL server"},
    {"id": "stmt-to-program", "match": "to program", "reason": "COPY ... TO PROGRAM executes a shell command on the PostgreSQL server"},
    {"id": "stmt-load", "match": "load", "reason": "LOAD loads data or a shared library into the server"},
    {"id": "stmt-import", "match": "import", "reason": "IMPORT FOREIGN SCHEMA changes the schema"},
    {"id": "stmt-handler", "match": "handler", "reason": "HANDLER opens low-level table cursors that hold server resources"},
    {"id": "stmt-kill", "match": "kill", "reason": "KILL terminates sessions on the target server"},
    {"id": "stmt-shutdown", "match": "shutdown", "reason": "SHUTDOWN stops the target server"},
    {"id": "stmt-backup", "match": "backup", "reason": "BACKUP writes files and loads the server"},
    {"id": "stmt-restore", "match": "restore", "reason": "RESTORE overwrites databases"},
    {"id": "stmt-checkpoint", "match": "checkpoint", "reason": "CHECKPOINT forces server I/O"},
    {"id": "stmt-vacuum", "match": "vacuum", "reason": "VACUUM rewrites table storage"},
    {"id": "stmt-analyze", "match": "analyze", "reason": "ANALYZE writes statistics, and EXPLAIN ANALYZE executes the statement it explains"},
    {"id": "stmt-analyse", "match": "analyse", "reason": "ANALYSE is PostgreSQL's spelling of ANALYZE"},
    {"id": "stmt-optimize", "match": "optimize", "reason": "OPTIMIZE TABLE rewrites table storage"},
    {"id": "stmt-repair", "match": "repair", "reason": "REPAIR TABLE rewrites table storage"},
    {"id": "stmt-reindex", "match": "reindex", "reason": "REINDEX rewrites indexes"},
    {"id": "stmt-cluster", "match": "cluster", "reason": "CLUSTER rewrites table storage"},
    {"id": "stmt-refresh", "match": "refresh", "reason": "REFRESH MATERIALIZED VIEW rewrites a materialised view"},
    {"id": "stmt-listen", "match": "listen", "reason": "LISTEN changes session state"},
    {"id": "stmt-notify", "match": "notify", "reason": "NOTIFY publishes to a channel"},
    {"id": "stmt-unlisten", "match": "unlisten", "reason": "UNLISTEN changes session state"},
    {"id": "stmt-discard", "match": "discard", "reason": "DISCARD resets session state"},
    {"id": "stmt-reassign", "match": "reassign", "reason": "REASSIGN OWNED changes ownership"},
    {"id": "stmt-purge", "match": "purge", "reason": "PURGE removes binary logs"},
    {"id": "stmt-writetext", "match": "writetext", "reason": "WRITETEXT writes column data"},
    {"id": "stmt-updatetext", "match": "updatetext", "reason": "UPDATETEXT writes column data"},
    {"id": "stmt-readtext", "match": "readtext", "reason": "READTEXT is a deprecated cursor-like read the gate cannot bound"},
    {"id": "stmt-setuser", "match": "setuser", "reason": "SETUSER impersonates another user"}
  ],

  "forbidden_functions": [
    {"id": "fn-openrowset", "match": "openrowset", "reason": "OPENROWSET reads and writes through an ad hoc external connection"},
    {"id": "fn-openquery", "match": "openquery", "reason": "OPENQUERY passes an uninspectable statement to a linked server"},
    {"id": "fn-opendatasource", "match": "opendatasource", "reason": "OPENDATASOURCE opens an ad hoc external connection"},
    {"id": "fn-openxml", "match": "openxml", "reason": "OPENXML depends on sp_xml_preparedocument handles the gate cannot inspect"},
    {"id": "fn-xp-cmdshell", "match": "xp_cmdshell", "reason": "xp_cmdshell runs a shell command on the SQL Server host"},
    {"id": "fn-xp-regwrite", "match": "xp_regwrite", "reason": "xp_regwrite writes the Windows registry"},
    {"id": "fn-xp-regread", "match": "xp_regread", "reason": "xp_regread reads the Windows registry"},
    {"id": "fn-xp-regdeletekey", "match": "xp_regdeletekey", "reason": "xp_regdeletekey deletes registry keys"},
    {"id": "fn-xp-regdeletevalue", "match": "xp_regdeletevalue", "reason": "xp_regdeletevalue deletes registry values"},
    {"id": "fn-xp-regaddmultistring", "match": "xp_regaddmultistring", "reason": "xp_regaddmultistring writes the Windows registry"},
    {"id": "fn-xp-instance-regwrite", "match": "xp_instance_regwrite", "reason": "xp_instance_regwrite writes the Windows registry"},
    {"id": "fn-xp-dirtree", "match": "xp_dirtree", "reason": "xp_dirtree enumerates the SQL Server host filesystem"},
    {"id": "fn-xp-subdirs", "match": "xp_subdirs", "reason": "xp_subdirs enumerates the SQL Server host filesystem"},
    {"id": "fn-xp-fileexist", "match": "xp_fileexist", "reason": "xp_fileexist probes the SQL Server host filesystem"},
    {"id": "fn-xp-servicecontrol", "match": "xp_servicecontrol", "reason": "xp_servicecontrol starts and stops Windows services"},
    {"id": "fn-xp-terminate-process", "match": "xp_terminate_process", "reason": "xp_terminate_process kills processes on the host"},
    {"id": "fn-xp-makecab", "match": "xp_makecab", "reason": "xp_makecab writes archive files on the host"},
    {"id": "fn-xp-sendmail", "match": "xp_sendmail", "reason": "xp_sendmail exfiltrates data by mail"},
    {"id": "fn-sp-oacreate", "match": "sp_oacreate", "reason": "sp_OACreate instantiates OLE automation objects"},
    {"id": "fn-sp-oamethod", "match": "sp_oamethod", "reason": "sp_OAMethod invokes OLE automation methods"},
    {"id": "fn-sp-oagetproperty", "match": "sp_oagetproperty", "reason": "sp_OAGetProperty reads OLE automation objects"},
    {"id": "fn-sp-oasetproperty", "match": "sp_oasetproperty", "reason": "sp_OASetProperty writes OLE automation objects"},
    {"id": "fn-sp-execute-external-script", "match": "sp_execute_external_script", "reason": "sp_execute_external_script runs R, Python or Java on the server"},
    {"id": "fn-sp-executesql", "match": "sp_executesql", "reason": "sp_executesql runs dynamic SQL the gate cannot inspect"},
    {"id": "fn-sp-configure", "match": "sp_configure", "reason": "sp_configure changes server configuration"},
    {"id": "fn-sp-addextendedproc", "match": "sp_addextendedproc", "reason": "sp_addextendedproc registers a DLL as an extended procedure"},
    {"id": "fn-sp-send-dbmail", "match": "sp_send_dbmail", "reason": "sp_send_dbmail exfiltrates data by mail"},
    {"id": "fn-sp-makewebtask", "match": "sp_makewebtask", "reason": "sp_makewebtask writes files on the host"},
    {"id": "fn-sp-msforeachtable", "match": "sp_msforeachtable", "reason": "sp_MSforeachtable runs an uninspectable statement per table"},
    {"id": "fn-sp-msforeachdb", "match": "sp_msforeachdb", "reason": "sp_MSforeachdb runs an uninspectable statement per database"},

    {"id": "fn-pg-read-file", "match": "pg_read_file", "reason": "pg_read_file reads files on the PostgreSQL server"},
    {"id": "fn-pg-read-binary-file", "match": "pg_read_binary_file", "reason": "pg_read_binary_file reads files on the PostgreSQL server"},
    {"id": "fn-pg-ls-dir", "match": "pg_ls_dir", "reason": "pg_ls_dir enumerates the PostgreSQL server filesystem"},
    {"id": "fn-pg-stat-file", "match": "pg_stat_file", "reason": "pg_stat_file probes the PostgreSQL server filesystem"},
    {"id": "fn-pg-file-write", "match": "pg_file_write", "reason": "pg_file_write writes files on the PostgreSQL server"},
    {"id": "fn-pg-file-unlink", "match": "pg_file_unlink", "reason": "pg_file_unlink deletes files on the PostgreSQL server"},
    {"id": "fn-pg-file-rename", "match": "pg_file_rename", "reason": "pg_file_rename renames files on the PostgreSQL server"},
    {"id": "fn-lo-import", "match": "lo_import", "reason": "lo_import reads a server-side file into a large object"},
    {"id": "fn-lo-export", "match": "lo_export", "reason": "lo_export writes a large object to a server-side file"},
    {"id": "fn-lo-unlink", "match": "lo_unlink", "reason": "lo_unlink deletes a large object"},
    {"id": "fn-lo-put", "match": "lo_put", "reason": "lo_put writes a large object"},
    {"id": "fn-lo-create", "match": "lo_create", "reason": "lo_create creates a large object"},
    {"id": "fn-lo-from-bytea", "match": "lo_from_bytea", "reason": "lo_from_bytea creates a large object"},
    {"id": "fn-dblink-exec", "match": "dblink_exec", "reason": "dblink_exec runs an uninspectable statement on another server"},
    {"id": "fn-dblink", "match": "dblink", "reason": "dblink runs an uninspectable statement on another server"},
    {"id": "fn-dblink-connect", "match": "dblink_connect", "reason": "dblink_connect opens a connection to another server"},
    {"id": "fn-dblink-connect-u", "match": "dblink_connect_u", "reason": "dblink_connect_u opens an unprivileged-user connection to another server"},
    {"id": "fn-query-to-xml", "match": "query_to_xml", "reason": "query_to_xml executes a statement passed as a string"},
    {"id": "fn-pg-terminate-backend", "match": "pg_terminate_backend", "reason": "pg_terminate_backend kills sessions on the target server"},
    {"id": "fn-pg-cancel-backend", "match": "pg_cancel_backend", "reason": "pg_cancel_backend cancels queries on the target server"},
    {"id": "fn-pg-reload-conf", "match": "pg_reload_conf", "reason": "pg_reload_conf reloads server configuration"},
    {"id": "fn-pg-rotate-logfile", "match": "pg_rotate_logfile", "reason": "pg_rotate_logfile changes server state"},
    {"id": "fn-pg-switch-wal", "match": "pg_switch_wal", "reason": "pg_switch_wal forces a write-ahead log switch"},
    {"id": "fn-pg-backup-start", "match": "pg_backup_start", "reason": "pg_backup_start puts the server into backup mode"},
    {"id": "fn-pg-backup-stop", "match": "pg_backup_stop", "reason": "pg_backup_stop ends backup mode"},
    {"id": "fn-set-config", "match": "set_config", "reason": "set_config changes session or server settings"},
    {"id": "fn-nextval", "match": "nextval", "reason": "nextval advances a sequence, which is a write"},
    {"id": "fn-setval", "match": "setval", "reason": "setval writes a sequence"},
    {"id": "fn-pg-advisory-lock", "match": "pg_advisory_lock", "reason": "pg_advisory_lock holds a lock on the target server"},
    {"id": "fn-pg-advisory-lock-shared", "match": "pg_advisory_lock_shared", "reason": "pg_advisory_lock_shared holds a lock on the target server"},
    {"id": "fn-pg-advisory-xact-lock", "match": "pg_advisory_xact_lock", "reason": "pg_advisory_xact_lock holds a lock on the target server"},
    {"id": "fn-pg-try-advisory-lock", "match": "pg_try_advisory_lock", "reason": "pg_try_advisory_lock holds a lock on the target server"},
    {"id": "fn-pg-advisory-unlock", "match": "pg_advisory_unlock", "reason": "pg_advisory_unlock manipulates locks on the target server"},
    {"id": "fn-pg-advisory-unlock-all", "match": "pg_advisory_unlock_all", "reason": "pg_advisory_unlock_all manipulates locks on the target server"},
    {"id": "fn-pg-sleep", "match": "pg_sleep", "reason": "pg_sleep holds the connection open; the gate cannot judge the magnitude"},
    {"id": "fn-pg-sleep-for", "match": "pg_sleep_for", "reason": "pg_sleep_for holds the connection open; the gate cannot judge the magnitude"},
    {"id": "fn-pg-sleep-until", "match": "pg_sleep_until", "reason": "pg_sleep_until holds the connection open; the gate cannot judge the magnitude"},

    {"id": "fn-load-file", "match": "load_file", "reason": "LOAD_FILE reads a file on the MySQL server"},
    {"id": "fn-get-lock", "match": "get_lock", "reason": "GET_LOCK holds a named lock on the target server"},
    {"id": "fn-release-lock", "match": "release_lock", "reason": "RELEASE_LOCK manipulates named locks on the target server"},
    {"id": "fn-master-pos-wait", "match": "master_pos_wait", "reason": "MASTER_POS_WAIT blocks until replication catches up"},
    {"id": "fn-sys-exec", "match": "sys_exec", "reason": "sys_exec is a MySQL UDF that runs a shell command"},
    {"id": "fn-sys-eval", "match": "sys_eval", "reason": "sys_eval is a MySQL UDF that runs a shell command"},
    {"id": "fn-sys-bineval", "match": "sys_bineval", "reason": "sys_bineval is a MySQL UDF that runs shellcode"},
    {"id": "fn-sleep", "match": "sleep", "reason": "SLEEP holds the connection open; the gate cannot judge the magnitude"},
    {"id": "fn-benchmark", "match": "benchmark", "reason": "BENCHMARK burns CPU on the target server"}
  ],

